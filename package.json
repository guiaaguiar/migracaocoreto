{
  "name": "migracaocoreto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server:dev": "tsx watch server/src/index.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node server/dist/index.js",
    "db:setup": "tsx server/src/db/setup.ts",
    "dev:all": "concurrently -n \"VITE,API\" -c \"cyan,magenta\" \"npm run dev\" \"npm run server:dev\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "keycloak-js": "^26.2.4",
    "lucide-react": "^1.31.0",
    "pg": "^8.13.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.1.2",
    "oxlint": "^1.75.0",
    "tsx": "^4.19.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
