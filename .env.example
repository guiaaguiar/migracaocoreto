# ─── Configurações do Banco de Dados PostgreSQL ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coreto_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=coreto_db

# ─── Configurações do Servidor Backend ───
PORT=3001
NODE_ENV=development

# ─── Configurações do Frontend (Vite) ───
VITE_API_BASE_URL=/api
